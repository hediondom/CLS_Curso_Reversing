<?xml version="1.0" encoding="UTF-8"?>
<compiler_spec>
    <default_proto>
        <prototype name="__stdcall" extrapop="unknown" stackshift="4">
            <input>
                <pentry minsize="1" maxsize="4">
                    <register name="acc"/>
                </pentry>
            </input>
            <output>
                <pentry minsize="1" maxsize="4">
                    <register name="acc"/>
                </pentry>
            </output>
            <unaffected>
                <register name="vsp"/>
            </unaffected>
        </prototype>
    </default_proto>
</compiler_spec>
